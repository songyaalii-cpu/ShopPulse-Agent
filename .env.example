# Local development defaults only. Use unique secrets outside local development.
POSTGRES_DB=shoppulse
POSTGRES_USER=shoppulse
POSTGRES_PASSWORD=shoppulse_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://shoppulse:shoppulse_local_only@localhost:5432/shoppulse

# Reserved for LangGraph checkpoint/memory persistence. Business code must not use it.
LANGGRAPH_DATABASE_URL=postgresql+psycopg://shoppulse:shoppulse_local_only@localhost:5432/shoppulse_langgraph

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
SQL_QUERY_TIMEOUT_MS=5000
SQL_MAX_ROWS=200
APP_ENV=development
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_KEY_PREFIX=shoppulse:
LLM_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Compose injects INTERNAL_API_URL=http://api:8000 for server-side rendering.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
SSE_HEARTBEAT_SECONDS=15
SSE_STREAM_TTL_SECONDS=3600
RUN_TIMEOUT_SECONDS=180
RUN_MAX_RETRIES=2
WORKER_CONCURRENCY=2
TOKEN_PRICING_CONFIG=shoppulse/evals/pricing.json
DEMO_USER_ID=local-demo
SUBMIT_RATE_LIMIT_PER_MINUTE=30

# Existing optional workshop settings
WORKSHOP_MODEL=anthropic:claude-haiku-4-5
EMBEDDING_PROVIDER=huggingface
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=shoppulse-development
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGGRAPH_DEPLOYMENT_URL=

# Model provider credentials (leave unset unless that provider is used)
# For DeepSeek through the OpenAI-compatible client:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=
# AWS_MODEL_ARN=
